ZAI_API_KEY=your-zai-key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3

# Optional cost-model overrides (USD per 1M tokens) used on the /runs page.
# Defaults are glm-5.3 list prices: 1.40 input / 4.40 per 1M tokens.
# ZAI_INPUT_PRICE=1.40
# ZAI_OUTPUT_PRICE=4.40

# Postgres (Neon) for persisted pipeline runs — optional.
# Without it (and without ZAI_API_KEY) the app serves the prerecorded demo
# run from data/demo-run.json; running the live pipeline needs both.
DATABASE_URL=
